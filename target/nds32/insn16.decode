#
# Encodings follow the AndeStar V3 instruction formats.  A 32-bit
# instruction has bit 31 clear, a 16-bit one has bit 15 set.

&h2         rt ra
&h3         rt ra rb
&hri        rt ra imm
&hi         rt imm
&himm        imm
&hra         ra
&hbr         rt imm
&hpp25       re imm

@br38       . .... rt:3 imm:s8                      &hbr
@j8         . ....... imm:s8                        &himm
@r55        . ..... rt:5 ra:5                       &h2
@ri55       . ..... rt:5 imm:s5                     &hi
@r45        . ...... rt:4 ra:5                      &h2
@ri45       . ...... rt:4 imm:5                     &hi
@ri333      . ...... rt:3 ra:3 imm:3                &hri
@r333       . ...... rt:3 ra:3 rb:3                 &h3
@r33        . ...... rt:3 ra:3 ...                  &h2
@ri33a      . ...... rt:3 imm:3 ...                 &hi
@ri36       . ...... rt:3 imm:6                     &hi
@m37        . .... rt:3 . imm:7                     &hi
@ra5        . .......... ra:5                       &hra
@i5         . .......... imm:5                      &himm
@i9         . ...... imm:9                          &himm
@i10        . ..... imm:s10                         &himm
@movd       . ....... rt:4 ra:4                     &h2
@pp25       . ........ re:2 imm:5                   &hpp25

&hnone
@none16     ................                        &hnone

beqz38       11000........... @br38
bnez38       11001........... @br38
movi55       100001.......... @ri55
add45        1000100......... @r45
sub45        1000101......... @r45
addi45       1000110......... @ri45
subi45       1000111......... @ri45
srai45       1001000......... @ri45
srli45       1001001......... @ri45
slli333      1001010......... @ri333
add333       1001100......... @r333
sub333       1001101......... @r333
addi333      1001110......... @ri333
subi333      1001111......... @ri333
zeb33        1001011......000 @r33
zeh33        1001011......001 @r33
seb33        1001011......010 @r33
seh33        1001011......011 @r33
xlsb33       1001011......100 @r33
x11b33       1001011......101 @r33
bmski33      1001011......110 @ri33a
fexti33      1001011......111 @ri33a
lwi333       1010000......... @ri333
lwi333_bi    1010001......... @ri333
lhi333       1010010......... @ri333
lbi333       1010011......... @ri333
swi333       1010100......... @ri333
swi333_bi    1010101......... @ri333
shi333       1010110......... @ri333
sbi333       1010111......... @ri333
addri36_sp   1011000......... @ri36
lwi45_fe     1011001......... @ri45
lwi450       1011010......... @r45
swi450       1011011......... @r45
lwi37        10111...0....... @m37
swi37        10111...1....... @m37
slts45       1110000......... @r45
slt45        1110001......... @r45
sltsi45      1110010......... @ri45
slti45       1110011......... @ri45
beqzs8       11101000........ @j8
bnezs8       11101001........ @j8
addi10_sp    111011.......... @i10
lwi37_sp     11110...0....... @m37
swi37_sp     11110...1....... @m37
ifcall9      1111100......... @i9
movpi45      1111101......... @ri45
movd44       11111101........ @movd
push25       111111000....... @pp25
pop25        111111001....... @pp25
neg33        1111111......010 @r33
not33        1111111......011 @r33
mul33        1111111......100 @r33
xor33        1111111......101 @r33
and33        1111111......110 @r33
or33         1111111......111 @r33
{
  ifret16     1000001111111111 @none16
  mov55        100000.......... @r55
}
{
  j8           11010101........ @j8
  beqs38       11010........... @br38
}
{
  break16      11101010000..... @i5
  ex9_it       1110101......... @i9
}
{
  jr5          11011101000..... @ra5
  jral5        11011101001..... @ra5
  ex9_it5      11011101010..... @i5
  ret5         11011101100..... @ra5
  add5_pc      11011101101..... @ra5
  bnes38       11011........... @br38
}
