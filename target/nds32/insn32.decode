div          0100001000.0..........0000101111 @dt3
mult32       0100001000.0..........0000110001 @dt3
madd32       0100001000.0..........0000110011 @dt3
msub32       0100001000.0..........0000110101 @dt3
mulsr64      0100001...............0001101000 @r3
mulr64       0100001...............0001101001 @r3
