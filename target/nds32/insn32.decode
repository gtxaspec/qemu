lhs          0011100.................00010001 @mem
dpref        0011100.................00010011 @mem
lbs_bi       0011100.................00010100 @mem
lhs_bi       0011100.................00010101 @mem
llw          0011100.................00011000 @mem
scw          0011100.................00011001 @mem
lbup         0011100.................00100000 @mem
lwup         0011100.................00100010 @mem
