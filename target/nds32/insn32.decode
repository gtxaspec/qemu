mtusr        0100001...............0000100001 @usr
mul          0100001...............0000100100 @r3
mults64      0100001000.0..........0000101000 @dt3
mult64       0100001000.0..........0000101001 @dt3
madds64      0100001000.0..........0000101010 @dt3
madd64       0100001000.0..........0000101011 @dt3
msubs64      0100001000.0..........0000101100 @dt3
msub64       0100001000.0..........0000101101 @dt3
