swup         0011100.................00101010 @mem
lsmw         0011101.......................00 @lsmw
lsmwa        0011101.......................01 @lsmw
add_slli     0100000....................00000 @r3s
sub_slli     0100000....................00001 @r3s
and_slli     0100000....................00010 @r3s
xor_slli     0100000....................00011 @r3s
or_slli      0100000....................00100 @r3s
nor          0100000...............0000000101 @r3
slt          0100000...............0000000110 @r3
slts         0100000...............0000000111 @r3
slli         0100000...............0000001000 @r2i5
srli         0100000...............0000001001 @r2i5
srai         0100000...............0000001010 @r2i5
rotri        0100000...............0000001011 @r2i5
sll          0100000...............0000001100 @r3
srl          0100000...............0000001101 @r3
sra          0100000...............0000001110 @r3
rotr         0100000...............0000001111 @r3
seb          0100000..........000000000010000 @r2
seh          0100000..........000000000010001 @r2
bitc         0100000...............0000010010 @r3
zeh          0100000..........000000000010011 @r2
wsbh         0100000..........000000000010100 @r2
or_srli      0100000....................10101 @r3s
divsr        0100000....................10110 @r4
divr         0100000....................10111 @r4
sva          0100000...............0000011000 @r3
svs          0100000...............0000011001 @r3
cmovz        0100000...............0000011010 @r3
cmovn        0100000...............0000011011 @r3
add_srli     0100000....................11100 @r3s
sub_srli     0100000....................11101 @r3s
and_srli     0100000....................11110 @r3s
xor_srli     0100000....................11111 @r3s
max          0100001...............0000000000 @r3
