msubr32      0100001...............0001110101 @r3
movi         0100010......................... @ri20s
sethi        0100011......................... @ri20u
j            01001000........................ @j24
jal          01001001........................ @j24
jr           0100101.....00000.....00...00000 @jreg
jral         0100101.....00000.....00...00001 @jreg
