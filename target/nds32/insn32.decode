#
# Encodings follow the AndeStar V3 instruction formats.  A 32-bit
# instruction has bit 31 clear, a 16-bit one has bit 15 set.

&r3         rt ra rb
&r3s        rt ra rb sh
&r4         rt rd ra rb
&r2         rt ra
&rri        rt ra imm
&ri         rt imm
&mem        rt ra rb sv
&dt3        dt ra rb
&j          imm
&br1        rt ra imm
&brr        rt imm
&br3        rt cimm imm
&jreg       rt rb hint
&lsmw       rb ra re enb4 s abdim
&usr        rt usr
&sr         rt sr
&swid       swid
&rt_swid    rt swid
&setend     e
&rt1        rt
&none
&misc        x

@r3         ....... rt:5 ra:5 rb:5 ..... .....      &r3
@r3s        ....... rt:5 ra:5 rb:5 sh:5 .....       &r3s
@r4         ....... rt:5 ra:5 rb:5 rd:5 .....       &r4
@r2         ....... rt:5 ra:5 ..... ..... .....     &r2
@r2i5       ....... rt:5 ra:5 imm:5 ..... .....     &rri
@mi15       ....... rt:5 ra:5 imm:s15               &rri
@rri15s     ....... rt:5 ra:5 imm:s15               &rri
@rri15u     ....... rt:5 ra:5 imm:15                &rri
@gp19       ....... rt:5 . imm:s19                  &ri
@gp18       ....... rt:5 .. imm:s18                 &ri
@gp17       ....... rt:5 ... imm:s17                &ri
@ri20s      ....... rt:5 imm:s20                    &ri
@ri20u      ....... rt:5 imm:20                     &ri
@mem        ....... rt:5 ra:5 rb:5 sv:2 .. ......   &mem
@dt3        ....... ... dt:1 . ra:5 rb:5 ..........  &dt3
@j24        ....... . imm:s24                       &j
@br1        ....... rt:5 ra:5 . imm:s14             &br1
@br2        ....... rt:5 .... imm:s16               &brr
@br3        ....... rt:5 . cimm:s11 imm:s8          &br3
@jreg       ....... rt:5 ..... rb:5 .. hint:3 ..... &jreg
@lsmw       ....... rb:5 ra:5 re:5 enb4:4 s:1 abdim:3 .. &lsmw
@usr        ....... rt:5 usr:10 ..... .....         &usr
@sr         ....... rt:5 sr:10 ..... .....          &sr
@swid       ....... ..... swid:15 .....             &swid
@rt_swid    ....... rt:5 swid:15 .....              &rt_swid
@setend     ....... .... e:1 ..... ..... ..... ..... &setend
@isync      ....... rt:5 ..... ..... ..... .....    &rt1
@none       ................................        &none
@misc       ....... x:20 .....                      &misc

lbi          0000000......................... @mi15
lhi          0000001......................... @mi15
lwi          0000010......................... @mi15
ldi          0000011......................... @mi15
lbi_bi       0000100......................... @mi15
lhi_bi       0000101......................... @mi15
lwi_bi       0000110......................... @mi15
ldi_bi       0000111......................... @mi15
sbi          0001000......................... @mi15
shi          0001001......................... @mi15
swi          0001010......................... @mi15
sdi          0001011......................... @mi15
sbi_bi       0001100......................... @mi15
shi_bi       0001101......................... @mi15
swi_bi       0001110......................... @mi15
sdi_bi       0001111......................... @mi15
lbsi         0010000......................... @mi15
lhsi         0010001......................... @mi15
lwsi         0010010......................... @mi15
lbsi_bi      0010100......................... @mi15
lhsi_bi      0010101......................... @mi15
lwsi_bi      0010110......................... @mi15
dprefi       0010011......................... @mi15
lbi_gp       0010111.....0................... @gp19
lbsi_gp      0010111.....1................... @gp19
lhi_gp       0011110.....00.................. @gp18
lhsi_gp      0011110.....01.................. @gp18
shi_gp       0011110.....10.................. @gp18
lwi_gp       0011110.....110................. @gp17
swi_gp       0011110.....111................. @gp17
sbi_gp       0011111.....0................... @gp19
addi_gp      0011111.....1................... @gp19
lb           0011100.................00000000 @mem
lh           0011100.................00000001 @mem
lw           0011100.................00000010 @mem
ld           0011100.................00000011 @mem
lb_bi        0011100.................00000100 @mem
lh_bi        0011100.................00000101 @mem
lw_bi        0011100.................00000110 @mem
ld_bi        0011100.................00000111 @mem
sb           0011100.................00001000 @mem
sh           0011100.................00001001 @mem
sw           0011100.................00001010 @mem
sd           0011100.................00001011 @mem
sb_bi        0011100.................00001100 @mem
sh_bi        0011100.................00001101 @mem
sw_bi        0011100.................00001110 @mem
sd_bi        0011100.................00001111 @mem
