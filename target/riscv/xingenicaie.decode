#
# Ingenic AIE vector extension (XIngenicAIE), as the T32Pro's TNPU cores run
# it: 32 128-bit vector registers (vp), four predicates (pr; pr0 reads all
# ones), in the custom-0 and custom-1 opcodes.
#
# Copyright (C) 2026 Alfonso Gamboa <gtxent@gmail.com>
#
# SPDX-License-Identifier: GPL-2.0-or-later

%imm8      27:3 20:5
%repb_idx  27:1 15:5
%movw_si   25:3 19:1
%movd_si   25:1 18:2

&r         rd rs1 rs2                  !extern
&aie_v     vd vs1 vs2 pg imm
&aie_mem     vd rs1 imm pg
&aie_elem     vd rs1 imm idx pg

# vd, vs1, vs2, predicated
@vv        ..... pg:2 vs2:5 vs1:5 ... vd:5 ....... &aie_v imm=0
# vd, vs1, vs2, not predicated
@vvn       ....... vs2:5 vs1:5 ... vd:5 ....... &aie_v imm=0 pg=0
# vd, vs1 (unary)
@vu        ..... pg:2 ..... vs1:5 ... vd:5 ....... &aie_v vs2=0 imm=0
# vd, vs2 (unary)
@vuf       ..... pg:2 vs2:5 ..... ... vd:5 ....... &aie_v vs1=0 imm=0
@vd        ..... pg:2 ..... ..... ... vd:5 ....... &aie_v vs1=0 vs2=0 imm=0
@vi        ..... pg:2 imm:5 vs1:5 ... vd:5 ....... &aie_v vs2=0
@vi8       ..... pg:2 ..... vs1:5 ... vd:5 ....... &aie_v vs2=0 imm=%imm8
@li        . imm:s16 ... vd:5 ....... &aie_v vs1=0 vs2=0 pg=0
@repb      ..... pg:2 vs2:5 ..... ... vd:5 ....... &aie_v vs1=0 imm=%repb_idx
@reph      ..... pg:2 vs2:5 imm:5 ... vd:5 ....... &aie_v vs1=0
@repw      ..... pg:2 vs2:5 . imm:4 ... vd:5 ....... &aie_v vs1=0
@repd      ..... pg:2 vs2:5 .. imm:3 ... vd:5 ....... &aie_v vs1=0
@movw      .... ... vs2:5 . vs1:4 ... vd:5 ....... &aie_v pg=0 imm=%movw_si
@movd      ...... . vs2:5 .. vs1:3 ... vd:5 ....... &aie_v pg=0 imm=%movd_si
@gt2w      .... vs1:1 pg:2 vs2:5 .... imm:1 ... vd:5 ....... &aie_v
# pd, vs1, vs2, predicated (pd in vd)
@pc        ..... pg:2 vs2:5 vs1:5 ... .. . vd:2 ....... &aie_v imm=0
# pd, ps1, ps2 (in vd, vs1, vs2)
@pp        ....... .. . vs2:2 .. . vs1:2 ... ... vd:2 ....... &aie_v pg=0 imm=0
@pdec      ....... ..... rs1:5 ... ... vd:2 ....... &aie_mem imm=0 pg=0
@pld       ....... imm:s5 rs1:5 ... ... vd:2 ....... &aie_mem pg=0
@psd       ....... ... vd:2 rs1:5 ... imm:s5 ....... &aie_mem pg=0
@ldv       ..... pg:2 imm:s5 rs1:5 ... vd:5 ....... &aie_mem
@stv       ..... pg:2 vd:5 rs1:5 ... imm:s5 ....... &aie_mem
@luv       ..... pg:2 ..... rs1:5 ... vd:5 ....... &aie_mem imm=0
@suv       ..... pg:2 vd:5 rs1:5 ... ..... ....... &aie_mem imm=0
@law       . idx:4 pg:2 imm:s5 rs1:5 ... vd:5 ....... &aie_elem
@lad       .. idx:3 pg:2 imm:s5 rs1:5 ... vd:5 ....... &aie_elem
@saw       . idx:4 pg:2 vd:5 rs1:5 ... imm:s5 ....... &aie_elem
@sad       .. idx:3 pg:2 vd:5 rs1:5 ... imm:s5 ....... &aie_elem
@r         ....... rs2:5 rs1:5 ... rd:5 ....... &r

# custom-0
aie_lih      0 ................ 001 ..... 0001011 @li
aie_liw      1 ................ 001 ..... 0001011 @li
aie_orib     01 ... .. ..... ..... 010 ..... 0001011 @vi8
aie_xorib    10 ... .. ..... ..... 010 ..... 0001011 @vi8
aie_movd     111010 . ..... ..... 010 ..... 0001011 @movd
aie_movw     1111 ... ..... ..... 010 ..... 0001011 @movw
aie_gshufvb  10011 .. ..... ..... 011 ..... 0001011 @vv
aie_repib    1010 . .. ..... ..... 011 ..... 0001011 @repb
aie_repih    10110 .. ..... ..... 011 ..... 0001011 @reph
aie_repiw    10111 .. ..... 0 .... 011 ..... 0001011 @repw
aie_repid    10111 .. ..... 10 ... 011 ..... 0001011 @repd
aie_umulhe   00010 .. ..... ..... 100 ..... 0001011 @vv
aie_umulho   00011 .. ..... ..... 100 ..... 0001011 @vv
aie_addb     00000 .. ..... ..... 101 ..... 0001011 @vv
aie_addh     00001 .. ..... ..... 101 ..... 0001011 @vv
aie_addw     00010 .. ..... ..... 101 ..... 0001011 @vv
aie_lavb     00011 .. ..... ..... 101 ..... 0001011 @ldv
aie_subb     00100 .. ..... ..... 101 ..... 0001011 @vv
aie_subh     00101 .. ..... ..... 101 ..... 0001011 @vv
aie_subw     00110 .. ..... ..... 101 ..... 0001011 @vv
aie_lavh     00111 .. ..... ..... 101 ..... 0001011 @ldv
aie_mulh     01001 .. ..... ..... 101 ..... 0001011 @vv
aie_mulw     01010 .. ..... ..... 101 ..... 0001011 @vv
aie_lavw     01011 .. ..... ..... 101 ..... 0001011 @ldv
aie_andb     01100 .. ..... ..... 101 ..... 0001011 @vv
aie_savb     10011 .. ..... ..... 101 ..... 0001011 @stv
aie_orb      10100 .. ..... ..... 101 ..... 0001011 @vv
aie_savh     10111 .. ..... ..... 101 ..... 0001011 @stv
aie_savw     11011 .. ..... ..... 101 ..... 0001011 @stv
aie_xorb     11100 .. ..... ..... 101 ..... 0001011 @vv

# custom-1
aie_faddw    00010 .. ..... ..... 000 ..... 0101011 @vv
aie_fsubw    00110 .. ..... ..... 000 ..... 0101011 @vv
aie_fmulw    01010 .. ..... ..... 000 ..... 0101011 @vv
aie_fmaxw    11010 .. ..... ..... 000 ..... 0101011 @vv
aie_fminw    00010 .. ..... ..... 001 ..... 0101011 @vv
aie_sllib    00100 .. ..... ..... 010 ..... 0101011 @vi
aie_sllih    00101 .. ..... ..... 010 ..... 0101011 @vi
aie_slliw    00110 .. ..... ..... 010 ..... 0101011 @vi
aie_sraiw    01110 .. ..... ..... 010 ..... 0101011 @vi
aie_srlib    11100 .. ..... ..... 010 ..... 0101011 @vi
aie_srlih    11101 .. ..... ..... 010 ..... 0101011 @vi
aie_srliw    11110 .. ..... ..... 010 ..... 0101011 @vi
aie_maxub    00000 .. ..... ..... 011 ..... 0101011 @vv
aie_maxuh    00001 .. ..... ..... 011 ..... 0101011 @vv
aie_maxuw    00010 .. ..... ..... 011 ..... 0101011 @vv
aie_maxsw    00110 .. ..... ..... 011 ..... 0101011 @vv
aie_maxu4bi  00111 .. ..... ..... 011 ..... 0101011 @vv
aie_minuw    01010 .. ..... ..... 011 ..... 0101011 @vv
aie_minsw    01110 .. ..... ..... 011 ..... 0101011 @vv
aie_ilveb    10000 .. ..... ..... 011 ..... 0101011 @vv
aie_ilveh    10001 .. ..... ..... 011 ..... 0101011 @vv
aie_ilvew    10010 .. ..... ..... 011 ..... 0101011 @vv
aie_ilved    10100 .. ..... ..... 011 ..... 0101011 @vv
aie_ilvob    11000 .. ..... ..... 011 ..... 0101011 @vv
aie_ilvoh    11001 .. ..... ..... 011 ..... 0101011 @vv
aie_ilvow    11010 .. ..... ..... 011 ..... 0101011 @vv
aie_ilvod    11100 .. ..... ..... 011 ..... 0101011 @vv
aie_pcleub   11101 .. ..... ..... 100 11 0 .. 0101011 @pc
aie_pcltub   11111 .. ..... ..... 100 01 0 .. 0101011 @pc
aie_psubs    0000011 ..... ..... 101 ..... 0101011 @r
aie_bselv    0010011 ..... ..... 101 ..... 0101011 @vvn
aie_fclew    0010101 ..... ..... 101 ..... 0101011 @vvn
aie_fcltw    0010110 ..... ..... 101 ..... 0101011 @vvn
aie_pld      0101001 ..... ..... 101 000 .. 0101011 @pld
aie_psd      0101010 00 0 .. ..... 101 ..... 0101011 @psd
aie_satuuhb  01100 .. 10000 ..... 101 ..... 0101011 @vu
aie_satuuwb  01100 .. 10010 ..... 101 ..... 0101011 @vu
aie_satuuwh  01100 .. 10011 ..... 101 ..... 0101011 @vu
aie_ffsiw    01101 .. 00010 ..... 101 ..... 0101011 @vu
aie_ffuiw    01101 .. 00110 ..... 101 ..... 0101011 @vu
aie_ftsiw    01101 .. 01010 ..... 101 ..... 0101011 @vu
aie_ftuiw    01101 .. 01110 ..... 101 ..... 0101011 @vu
aie_luvb     01110 .. 00000 ..... 101 ..... 0101011 @luv
aie_mfcpub   01110 .. 00001 ..... 101 ..... 0101011 @luv
aie_luvh     01110 .. 00100 ..... 101 ..... 0101011 @luv
aie_mfcpuh   01110 .. 00101 ..... 101 ..... 0101011 @luv
aie_luvw     01110 .. 01000 ..... 101 ..... 0101011 @luv
aie_mfcpuw   01110 .. 01001 ..... 101 ..... 0101011 @luv
aie_pidw     01110 .. 01110 00100 101 ..... 0101011 @vd
aie_pdec     0111000 01111 ..... 101 000 .. 0101011 @pdec
aie_pand     0111001 10 0 .. 00 0 .. 101 000 .. 0101011 @pp
aie_porn     0111010 10 0 .. 10 0 .. 101 000 .. 0101011 @pp
aie_extshl   10000 .. ..... 01011 101 ..... 0101011 @vuf
aie_extshh   10000 .. ..... 01111 101 ..... 0101011 @vuf
aie_extu4bil 10000 .. ..... 10010 101 ..... 0101011 @vuf
aie_extubl   10000 .. ..... 10011 101 ..... 0101011 @vuf
aie_extubh   10000 .. ..... 10111 101 ..... 0101011 @vuf
aie_extuhl   10000 .. ..... 11011 101 ..... 0101011 @vuf
aie_extuhh   10000 .. ..... 11111 101 ..... 0101011 @vuf
aie_gth      10010 .. ..... 00111 101 ..... 0101011 @vuf
aie_gtb      10010 .. ..... 01011 101 ..... 0101011 @vuf
aie_suvb     10011 .. ..... ..... 101 00000 0101011 @suv
aie_suvh     10011 .. ..... ..... 101 00100 0101011 @suv
aie_suvw     10011 .. ..... ..... 101 01000 0101011 @suv
aie_gt2w     1101 . .. ..... 0001 . 101 ..... 0101011 @gt2w
aie_law      0 .... .. ..... ..... 110 ..... 0101011 @law
aie_lad      10 ... .. ..... ..... 110 ..... 0101011 @lad
aie_saw      0 .... .. ..... ..... 111 ..... 0101011 @saw
aie_sad      10 ... .. ..... ..... 111 ..... 0101011 @sad
