# Ingenic XBurst2 MXU3 (SIMD512) instruction set
#
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Reference:
#       XBurst Instruction Set Architecture MXU3 Programming Manual,
#       revision 1.0

&ldst               vr base offset n
&cr                 rt cr
&sum                vr sr
&mxsum              vd vs sr
&r3                 vd vs vp df
&r2                 vd vs df
&ri                 vd vs imm df
&v3                 vd vs vp
&w3                 vd vs vp p df
&mac                vs vp sr p
&li                 vd imm
&lsx                vr base fmt xe np u
&vi                 vd vs imm
&b                  vs offset df

%off_w              16:s5 !function=times_4
%off_d              16:s5 !function=times_8
%off_q              16:s5 !function=times_16
%off_o              16:s5 !function=times_32
%imm8               0:3 11:5
%le_mac             21:2 5:1
%imm16              16:5 0:6 11:5
%simm16             16:s5 0:6 11:5
%simm8              16:s5 0:3
%mov_fmt            25:1 20:1

# vrs is bits 20:16, vrp 15:11 and vrd 10:6
@3r                 ...... ..... vs:5 vp:5 vd:5 .... df:2       &r3
@3r_fmt3            ...... ..... vs:5 vp:5 vd:5 ... df:3        &r3
@2r                 ...... ..... vs:5 ..... vd:5 .... df:2      &r2
@ri                 ...... ..... vs:5 imm:5 vd:5 .... df:2      &ri
@v3                 ...... ..... vs:5 vp:5 vd:5 ......          &v3
@w3                 ...... ..... vs:5 vp:5 vd:5 .... p:1 df:1   &w3
@mac                ...... ..... vs:5 vp:5 ... sr:2 ......      &mac p=0
@mac_p              ...... ..... vs:5 vp:5 ... sr:2 .... p:1 .  &mac
@vi8                ...... ..... vs:5 ..... vd:5 ... ...        &vi imm=%imm8
@b                  ...... ..... vs:5 offset:s10 .... df:2      &b

# Element n of vr is loaded from or stored to offset(base); the U forms
# have no offset and add the element size to base afterwards.
@law                ...... base:5 ..... n:5 vr:5 ......             &ldst offset=%off_w
@lad                ...... base:5 ..... n:4 . vr:5 ......           &ldst offset=%off_d
@laq                ...... base:5 ..... n:3 .. vr:5 ......          &ldst offset=%off_q
@lao                ...... base:5 ..... n:2 ... vr:5 ......         &ldst offset=%off_o
@luw                ...... base:5 ..... n:5 vr:5 ......             &ldst offset=0
@lud                ...... base:5 ..... n:4 . vr:5 ......           &ldst offset=0
@luq                ...... base:5 ..... n:3 .. vr:5 ......          &ldst offset=0
@luo                ...... base:5 ..... n:2 ... vr:5 ......         &ldst offset=0
@saw                ...... base:5 ..... vr:5 n:5 ......             &ldst offset=%off_w
@sad                ...... base:5 ..... vr:5 n:4 . ......           &ldst offset=%off_d
@saq                ...... base:5 ..... vr:5 n:3 .. ......          &ldst offset=%off_q
@sao                ...... base:5 ..... vr:5 n:2 ... ......         &ldst offset=%off_o
@suw                ...... base:5 ..... vr:5 n:5 ......             &ldst offset=0
@sud                ...... base:5 ..... vr:5 n:4 . ......           &ldst offset=0
@suq                ...... base:5 ..... vr:5 n:3 .. ......          &ldst offset=0
@suo                ...... base:5 ..... vr:5 n:2 ... ......         &ldst offset=0

# SPECIAL2 major opcode

CTCMXU              011100 rt:5 10001 cr:5 00000 000011             &cr
CFCMXU              011100 00000 10000 cr:5 rt:5 000011             &cr
LAW                 011100 ..... ..... ..... ..... 010000           @law
LAD                 011100 ..... ..... ....0 ..... 010001           @lad
LAQ                 011100 ..... ..... ...01 ..... 010001           @laq
LAO                 011100 ..... ..... ..011 ..... 010001           @lao
LUW                 011100 ..... 00000 ..... ..... 010010           @luw
LUD                 011100 ..... 00000 ....0 ..... 010011           @lud
LUQ                 011100 ..... 00000 ...01 ..... 010011           @luq
LUO                 011100 ..... 00000 ..011 ..... 010011           @luo
SAW                 011100 ..... ..... ..... ..... 010100           @saw
SAD                 011100 ..... ..... ..... ....0 010101           @sad
SAQ                 011100 ..... ..... ..... ...01 010101           @saq
SAO                 011100 ..... ..... ..... ..011 010101           @sao
SUW                 011100 ..... 00000 ..... ..... 010110           @suw
SUD                 011100 ..... 00000 ..... ....0 010111           @sud
SUQ                 011100 ..... 00000 ..... ...01 010111           @suq
SUO                 011100 ..... 00000 ..... ..011 010111           @suo

# Strided loads and stores of a word, doubleword, quadword or octword at
# base, the update forms (u) advancing it. fmt is the element size from
# B for loads, from W for stores, xe the stride, np the n and p operands.
LSXW                011100 base:5 fmt:1 xe:3 np:5 0 vr:5 0110 u:1 1     &lsx
LSXD                011100 base:5 fmt:2 xe:2 np:4 01 vr:5 0110 u:1 1    &lsx
LSXQ                011100 base:5 fmt:2 xe:2 np:3 011 vr:5 0110 u:1 1   &lsx
LSXO                011100 base:5 fmt:3 xe:1 np:2 0111 vr:5 0110 u:1 1  &lsx
SSXD                011100 base:5 xe:2 000 vr:5 np:4 0 0111 u:1 1       &lsx fmt=0
SSXQ                011100 base:5 fmt:1 0 xe:1 00 vr:5 np:3 01 0111 u:1 1 &lsx
SSXO                011100 base:5 fmt:2 xe:1 00 vr:5 np:2 011 0111 u:1 1 &lsx

# VWR word vwd/vwp, GPR rd/rs and FPR fd/fs moves
MFCPUW              011100 rs:5 11011 00000 vwd:5 000011
MTCPUW              011100 11010 00000 vwp:5 rd:5 101110
MTFPUW              011100 11000 00000 vwp:5 fd:5 101110
MFFPUW              011100 11001 fs:5 00000 vwd:5 101110
CMVW                011100 0 imm:4 vs:5 vp:5 vd:5 110010

# Shuffle and permute. GT2W is 0000m in n_m, as on the T40 and T41, not
# the manual's 0001m.
GT                  011100 01110 00 fmt:3 vp:5 vd:5 110100
GTN                 011100 fp:5 nm:5 vp:5 vd:5 110101
EXTUW               011100 1000 w:1 hi:1 zp:1 fmt:3 vp:5 vd:5 110001
EXT                 011100 01101 s:1 hi:1 fmt:3 vp:5 vd:5 110001
EXTU3BW             011100 01100 00000 vp:5 vd:5 110001
REPI                011100 00 fn:8 vp:5 vd:5 110000
MOVW                011100 m:5 n:5 vp:5 vd:5 110110
MOV                 011100 . m:4 . n:4 vp:5 vd:5 110111     fmt=%mov_fmt
SHUF                011100 0 grp:2 fmt:2 00000 vp:5 vd:5 110011
ILV                 011100 odd:1 fmt:4 vs:5 vp:5 vd:5 111000
BSHI                011100 0 right:1 0 imm:7 vp:5 vd:5 111001
BSH                 011100 0 right:1 100 vs:5 vp:5 vd:5 111001

# Generic shuffles: MXU3.1 drops GSHUFWB, GSHUFB, GSHUFWH and GSHUFH and
# adds GSHUFWB1, GSHUFWB2 and GSHUFVB
GSHUFW              011100 100 imm:2 vs:5 vp:5 vd:5 111011
GSHUFWB             011100 11000 ..... ..... ..... 111011       @v3
GSHUFWB1            011100 1010 p:1 vs:5 vp:5 vd:5 111011
GSHUFWB2            011100 1110 p:1 vs:5 vp:5 vd:5 111011
GSHUFB              011100 00001 ..... ..... ..... 101011       @v3
GSHUFWH             011100 10000 ..... ..... ..... 101110       @v3
GSHUFH              011100 10100 ..... ..... ..... 101110       @v3
GSHUFVB             011100 11100 ..... ..... ..... 101110       @v3

# Single-precision conversions
FCVT                011100 00 sel:3 vs:5 00000 vd:5 101110

# Saturation to tgt, from unsigned (UU) or signed elements
SATUU               011100 00 f:3 vs:5 00000 vd:5 101111
SATSS               011100 01 tgt:1 df:2 vs:5 00000 vd:5 101111
SATSU               011100 1 tgt:2 df:2 vs:5 00000 vd:5 101111

# COP2 major opcode. Format 3 of the B/H/W integer forms is mostly taken
# by the single-precision forms; the translator reserves it until then.

MINU                010010 10000 ..... ..... ..... 000 ...          @3r_fmt3
MAXU                010010 10000 ..... ..... ..... 001 ...          @3r_fmt3
{
  FMINAW            010010 10000 ..... ..... ..... 0100 11        @v3
  MINA              010010 10000 ..... ..... ..... 0100 ..        @3r
}
{
  FMINW             010010 10000 ..... ..... ..... 0101 11        @v3
  MINS              010010 10000 ..... ..... ..... 0101 ..        @3r
}
{
  FMAXAW            010010 10000 ..... ..... ..... 0110 11        @v3
  MAXA              010010 10000 ..... ..... ..... 0110 ..        @3r
}
{
  FMAXW             010010 10000 ..... ..... ..... 0111 11        @v3
  MAXS              010010 10000 ..... ..... ..... 0111 ..        @3r
}
CEQZ                010010 10000 ..... 00000 ..... 1000 ..          @2r
CLTZ                010010 10000 ..... 00000 ..... 1001 ..          @2r
{
  FCEQW             010010 10000 ..... ..... ..... 1010 11        @v3
  CEQ               010010 10000 ..... ..... ..... 1010 ..        @3r
}
CLEZ                010010 10000 ..... 00000 ..... 1011 ..          @2r
{
  FCORW             010010 10000 ..... ..... ..... 1100 11        @v3
  CLTU              010010 10000 ..... ..... ..... 1100 ..        @3r
}
{
  FCLTW             010010 10000 ..... ..... ..... 1101 11        @v3
  CLTS              010010 10000 ..... ..... ..... 1101 ..        @3r
}
CLEU                010010 10000 ..... ..... ..... 1110 ..          @3r
{
  FCLEW             010010 10000 ..... ..... ..... 1111 11        @v3
  CLES              010010 10000 ..... ..... ..... 1111 ..        @3r
}

SLL                 010010 10001 ..... ..... ..... 1000 ..          @3r
SRL                 010010 10001 ..... ..... ..... 1100 ..          @3r
SRLR                010010 10001 ..... ..... ..... 1101 ..          @3r
SRA                 010010 10001 ..... ..... ..... 1110 ..          @3r
SRAR                010010 10001 ..... ..... ..... 1111 ..          @3r

ANDV                010010 10011 ..... ..... ..... 000010           @v3
ANDNV               010010 10011 ..... ..... ..... 000011           @v3
ORV                 010010 10011 ..... ..... ..... 000100           @v3
ORNV                010010 10011 ..... ..... ..... 000101           @v3
XORV                010010 10011 ..... ..... ..... 000110           @v3
XORNV               010010 10011 ..... ..... ..... 000111           @v3
BSELV               010010 10011 ..... ..... ..... 001110           @v3
BEQZ                010010 10011 ..... .......... 0100 ..           @b
BNEZ                010010 10011 ..... .......... 0101 ..           @b
{
  FMULW             010010 10011 ..... ..... ..... 1000 11        @v3
  MUL               010010 10011 ..... ..... ..... 1000 ..        @3r
}
PMAP                010010 10011 ..... ..... ..... 0010 ..          @3r
LIWR                010010 10011 imm:s10 vwd:5 000000
FCADDW              010010 10011 ..... ..... ..... 111010           @v3
FXAS                010010 10011 00 le:3 vp:5 vd:5 111110
UMUL                010010 10011 ..... ..... ..... 1010 ..          @w3
SMUL                010010 10011 ..... ..... ..... 1011 ..          @w3
TOC                 010010 10011 vs:5 00000 000 sr:2 0110 df:2
MLAW                010010 10011 ..... ..... 000 .. 111000          @mac
MLSW                010010 10011 ..... ..... 000 .. 111100          @mac
SMLAH               010010 10011 ..... ..... 000 .. 1110 . 1        @mac_p
SMLSH               010010 10011 ..... ..... 000 .. 1111 . 1        @mac_p

{
  FADDW             010010 10100 ..... ..... ..... 0000 11        @v3
  ADD               010010 10100 ..... ..... ..... 0000 ..        @3r
}
{
  FSUBW             010010 10100 ..... ..... ..... 0010 11        @v3
  SUB               010010 10100 ..... ..... ..... 0010 ..        @3r
}
ABS                 010010 10100 ..... 00000 ..... 0011 ..          @2r
WADDU               010010 10100 ..... ..... ..... 1000 ..          @w3
WADDS               010010 10100 ..... ..... ..... 1001 ..          @w3
WSUBU               010010 10100 ..... ..... ..... 1010 ..          @w3
WSUBS               010010 10100 ..... ..... ..... 1011 ..          @w3

SLLI                010010 10101 ..... ..... ..... 1000 ..          @ri
SRLI                010010 10101 ..... ..... ..... 1100 ..          @ri
SRLRI               010010 10101 ..... ..... ..... 1101 ..          @ri
SRAI                010010 10101 ..... ..... ..... 1110 ..          @ri
SRARI               010010 10101 ..... ..... ..... 1111 ..          @ri

ANDIB               010010 11011 ..... ..... ..... 001 ...          @vi8
ORIB                010010 11011 ..... ..... ..... 010 ...          @vi8
XORIB               010010 11011 ..... ..... ..... 011 ...          @vi8
WUMUL               010010 11011 ..... ..... ..... 1010 ..          @w3
WSMUL               010010 11011 ..... ..... ..... 1011 ..          @w3
ADDIW               010010 11011 ..... vwp:5 vwd:5 100 ...          imm=%simm8
ADDRW               010010 11011 00000 vwp:5 vwd:5 110100
FCMULRW             010010 11011 ..... ..... ..... 110000           @v3
FCMULIW             010010 11011 ..... ..... ..... 110010           @v3
WSMLAH              010010 11011 ..... ..... 000 .. 1110 . 1        @mac_p
WSMLSH              010010 11011 ..... ..... 000 .. 1111 . 1        @mac_p

# Segmented sums into word m of each segment of a sum register. t selects
# the element type; the segment length is 2^le words.
SRSUM               010010 10111 vs:5 00 le:3 t:3 sr:2 m:6
{
  SMAC              010010 111 t:2 vs:5 vp:5 111 sr:2 mle:6
  SRMAC             010010 111 .. vs:5 vp:5 t:3 sr:2 . mn:5     le=%le_mac
}

FCLASSW             010010 01000 vs:5 00000 vd:5 101110
LIH                 010010 11000 ..... ..... vd:5 ......            &li imm=%imm16
LIW                 010010 11001 ..... ..... vd:5 ......            &li imm=%simm16
LIWH                010010 11010 ..... ..... vd:5 ......            &li imm=%imm16

# Sum registers

SUMZ                010010 10011 00000 00000 000 sr:2 011100       &sum vr=0
MFSUM               010010 10011 00000 000 sr:2 vr:5 001111         &sum
MFSUMZ              010010 10011 00000 000 sr:2 vr:5 011110         &sum
MTSUM               010010 10011 vr:5 00000 000 sr:2 011101         &sum
MXSUM               010010 10011 vs:5 000 sr:2 vd:5 011111          &mxsum

# The NNA's instructions: imm splits around the register in the write forms
%nn_imm             16:5 6:5
&nn                 vr imm
NNRWR               011100 00000 ..... vr:5 ..... 111010           &nn imm=%nn_imm
NNRRD               011100 00001 imm:10 vr:5 111010                &nn
NNDWR               011100 00010 ..... vr:5 ..... 111010           &nn imm=%nn_imm
NNDRD               011100 00011 imm:10 vr:5 111010                &nn
NNMAC               011100 00100 ..... vr:5 ..... 111010           &nn imm=%nn_imm
NNCMD               011100 00101 imm:15 111010                     &nn vr=0
