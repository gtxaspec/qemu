#
# libwifi.a members taken out: the lower MAC (WSM firmware), the MAC/PHY/RF
# drivers under it.
# Kept: hi_internal.o (the HMAC<->LMAC rings), scheduler.o, ti.o, apb.o,
# rtl.o, hif.o, phy_utils.o (register bit helpers), dbg_print.o (putc),
# sm_region.o (the LMAC packet memory, where hi_sdio.o keeps its buffers),
# pwr_ARESA.o (power), and all of HMAC.
